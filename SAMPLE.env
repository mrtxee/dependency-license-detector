# Минимальная достаточная конфигурация для работы модуля
## Путь к рабочей директории
WORKDIR_BASE_PATH=/
## Относительный путь к файлу с результатом работы утилиты, внутри WORKDIR_BASE_PATH
DETECTED_LICENSES_FILE=detected-licenses.json
## Относительный путь для временных файлов, внутри WORKDIR_BASE_PATH
TEMP_DIR=tmp